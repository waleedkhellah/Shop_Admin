@page "{id:int}"
@model Shop_Admin.Pages.EditAdminModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Admin - Shop Admin</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Arial, Helvetica, sans-serif;
                background: #f5f7fb;
                color: #1f2937;
            }

            .sidebar {
                position: fixed;
                left: 0;
                top: 0;
                width: 240px;
                height: 100vh;
                background: #111827;
                color: white;
                padding: 25px 15px;
            }

            .logo {
                font-size: 24px;
                font-weight: bold;
                padding: 0 15px 30px;
            }

                .logo span {
                    color: #60a5fa;
                }

            .menu-title {
                color: #9ca3af;
                font-size: 12px;
                text-transform: uppercase;
                padding: 0 15px 10px;
            }

            .menu a {
                display: block;
                color: #d1d5db;
                text-decoration: none;
                padding: 13px 15px;
                border-radius: 8px;
                margin-bottom: 5px;
                font-size: 14px;
            }

                .menu a:hover {
                    background: #1f2937;
                    color: white;
                }

                .menu a.active {
                    background: #2563eb;
                    color: white;
                }

            .main {
                margin-left: 240px;
                min-height: 100vh;
            }

            .topbar {
                height: 70px;
                background: white;
                border-bottom: 1px solid #e5e7eb;
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0 30px;
            }

            .page-title {
                font-size: 22px;
                font-weight: bold;
            }

            .administrator {
                font-size: 14px;
                color: #6b7280;
            }

            .content {
                padding: 30px;
                max-width: 1000px;
            }

            .header {
                margin-bottom: 25px;
            }

                .header h1 {
                    margin: 0;
                    font-size: 26px;
                }

                .header p {
                    margin-top: 7px;
                    color: #6b7280;
                    font-size: 14px;
                }

            .form-card {
                background: white;
                border: 1px solid #e5e7eb;
                border-radius: 12px;
                padding: 30px;
            }

            .form-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
            }

            .form-group label {
                display: block;
                margin-bottom: 7px;
                font-size: 13px;
                font-weight: bold;
            }

            .form-group input,
            .form-group select {
                width: 100%;
                padding: 12px;
                border: 1px solid #d1d5db;
                border-radius: 7px;
                font-size: 14px;
                background: white;
            }

            .error-summary {
                color: #b91c1c;
                background: #fee2e2;
                padding: 12px;
                border-radius: 7px;
                margin-bottom: 20px;
            }

            .actions {
                margin-top: 25px;
                display: flex;
                gap: 10px;
            }

            .save-button {
                background: #2563eb;
                color: white;
                border: none;
                padding: 12px 22px;
                border-radius: 7px;
                cursor: pointer;
            }

            .cancel-button {
                background: #f3f4f6;
                color: #374151;
                text-decoration: none;
                padding: 12px 22px;
                border-radius: 7px;
            }

            @@media (max-width: 900px) {
                .form-grid {
                    grid-template-columns: 1fr;
                }
            }

            @@media (max-width: 700px) {
                .sidebar {
                    position: relative;
                    width: 100%;
                    height: auto;
                }

                .main {
                    margin-left: 0;
                }

                .content {
                    padding: 15px;
                }
            }
    </style>
</head>

<body>

    <aside class="sidebar">

        <div class="logo">
            Shop <span>Admin</span>
        </div>

        <div class="menu-title">
            Main Menu
        </div>

        <nav class="menu">

            <a href="/Dashboard">
                Dashboard
            </a>

            <a href="/AdminUsers" class="active">
                Admin Users
            </a>

            <a href="/Teachers">
                Teachers
            </a>

            <a href="/Login">
                Logout
            </a>

        </nav>

    </aside>

    <main class="main">

        <div class="topbar">

            <div class="page-title">
                Edit Admin
            </div>

            <div class="administrator">
                Administrator
            </div>

        </div>

        <div class="content">

            <div class="header">

                <h1>
                    Edit Admin
                </h1>

                <p>
                    Update administrator information.
                </p>

            </div>

            <div class="form-card">

                <form method="post" action="/EditAdmin/@Model.Admin.Id">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="Admin.Id" />

                    <div asp-validation-summary="ModelOnly"
                         class="error-summary">
                    </div>

                    <div class="form-grid">

                        <div class="form-group">
                            <label>First Name</label>
                            <input asp-for="Admin.FirstName" />
                        </div>

                        <div class="form-group">
                            <label>Last Name</label>
                            <input asp-for="Admin.LastName" />
                        </div>

                        <div class="form-group">
                            <label>Username</label>
                            <input asp-for="Admin.Username" />
                        </div>

                        <div class="form-group">
                            <label>Email</label>
                            <input asp-for="Admin.Email" type="email" />
                        </div>

                        <div class="form-group">
                            <label>New Password</label>
                            <input asp-for="NewPassword" type="password" />
                        </div>

                        <div class="form-group">

                            <label>
                                Gender
                            </label>

                            <select asp-for="Admin.Gender">

                                <option value="Male">
                                    Male
                                </option>

                                <option value="Female">
                                    Female
                                </option>

                            </select>

                        </div>

                        <div class="form-group">

                            <label>
                                Status
                            </label>

                            <select asp-for="Admin.Status">

                                <option value="Active">
                                    Active
                                </option>

                                <option value="Inactive">
                                    Inactive
                                </option>

                            </select>

                        </div>

                    </div>

                    <div class="actions">

                        <button type="submit"
                                class="save-button">

                            Save Changes

                        </button>

                        <a href="/AdminUsers"
                           class="cancel-button">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </main>

</body>
</html>